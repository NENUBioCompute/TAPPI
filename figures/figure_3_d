import requests
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# -----------------------------
# 1. Download data
# -----------------------------
url = "https://figshare.com/ndownloader/files/63428655"  # ← 你需要替换成实际DDG数据链接
local_file = "ddg_data.csv"

r = requests.get(url)
r.raise_for_status()

with open(local_file, "wb") as f:
    f.write(r.content)

print(f"Downloaded {local_file}")

# -----------------------------
# 2. Load data
# -----------------------------
# Expecting columns: label_ddg, pred_ddg
data = pd.read_csv(local_file)

print(data.head())

# -----------------------------
# 3. Plot violin
# -----------------------------
sns.set(style="whitegrid", font_scale=1.5)

plt.figure(figsize=(10, 8))

sns.violinplot(
    x='pred_ddg',
    y='label_ddg',
    data=data,
    palette=['#7E4909', '#E5CC8F', '#CCE5E5', '#0E8585']
)

plt.xlabel('Effect Type', fontsize=18)
plt.ylabel('ΔΔG Values', fontsize=18)

plt.xticks(
    ticks=[0, 1, 2, 3],
    labels=['disrupting', 'decreasing', 'no effect', 'increasing'],
    fontsize=18
)

plt.yticks(fontsize=18)
plt.grid()

plt.savefig('plot_DDG.png', dpi=300, bbox_inches='tight')
plt.show()
